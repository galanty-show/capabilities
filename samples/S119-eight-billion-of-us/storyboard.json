        "duration": 0.4
      }
    },
    {
      "id": "rate",
      "title": "增长率的峰与回落",
      "narration": "可转折，其实早就来了。全球人口增长率，在一九六三年见顶，约百分之二点三。此后一路回落，如今已不到百分之一。",
      "component": {
        "id": "scene.code",
        "params": {
          "module": "pc-rate",
          "props": {}
